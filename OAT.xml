<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
    <licensefile>License.md</licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="LGPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-3.0-or-later" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPL-2.1+" path="COPYING.LESSER" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name=".*windows"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                <filteritem type="filepath" name=".*yaml"
                    desc="" />
                <filteritem type="filepath" name="tables/el.ctb"
                    desc="" />
                <filteritem type="filepath" name="tables/grc-international-decomposed.uti"
                    desc="" />
                 </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="FSFULLR" desc="">
                <licensetext name="
                dnl This file is free software; the Free Software Foundation
                dnl gives unlimited permission to copy and/or distribute it,
                dnl with or without modifications, as long as this notice is preserved.
            " desc="" />
            </licensematcher>
            <licensematcher name="FSFAP" desc="">
                <licensetext name="
                # Copying and distribution of this file, with or without modification,
                # are permitted in any medium without royalty provided the copyright
                # notice and this notice are preserved.
            " desc="" />
            </licensematcher>
           
        </licensematcherlist>
        
    </oatconfig>
</configuration>