<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="Khronos License" path="SPIRV.*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0-with-bison-exception" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-3.0+" path=".*" desc="" />
                <policyitem type="compatibility" name="Khronos Group License" path="glslang/MachineIndependent.*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="gnulib.*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="tools/gnulib/getopt-pfx-core.h" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="tools/gnulib/errno.in.h" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="tools/gnulib/gettext.h" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="tools/gnulib/stdint.in.h" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="tools/gnulib.*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="autogen.sh" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path="contrib.*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="tables.*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="liblouis.*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="liblouis/internal.h" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="liblouis/commonTranslationFunctions.c" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="tests/braille-specs/en-nabcc.yaml" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path="liblouis/maketable.c" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path=".*" desc="" /> 
                <policyitem type="compatibility" name="LGPL-2.1+" path="COPYING.LESSER" desc="" />
                <policyitem type="compatibility" name="Copyright" path="tests/multiple_table_path.pl" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="third_party/llvm-10.0/llvm/include/llvm/Support/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/SPIRV-Tools/BUILD.bazel"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/LICENSE.TXT"
                    desc="" />
                <filteritem type="filepath" name="third_party/subzero/bloat/README.chromium"
                    desc="" />
                <filteritem type="filepath" name="third_party/llvm-10.0/Android.bp"
                    desc="" />
                <filteritem type="filepath" name=".*windows"
                    desc="" />
                <filteritem type="filepath" name=".*m4"
                    desc="" />
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
                 </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Copyright" desc="">
                <licensetext name="
               # Copyright (C) 2011 by Swiss Library for the Blind, Visually Impaired and Print Disabled
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>